{
  "name": "value-shift",
  "version": "0.1.0",
  "private": true,
  "description": "Value Shift — the AEC AI Economics Wind Tunnel. A deterministic scenario-rehearsal instrument: propagate an AI workflow through a firm's fee model, incentives, review capacity, and talent system before deploying it.",
  "scripts": {
    "dev": "set NODE_PATH=%CD%\\node_modules&& next dev --turbopack",
    "build": "set NODE_PATH=%CD%\\node_modules&& set NEXT_DIST_DIR=.next-build&& next build",
    "start": "set NEXT_DIST_DIR=.next-build&& next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.8"
  }
}
